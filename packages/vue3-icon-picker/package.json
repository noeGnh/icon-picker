{
  "name": "vue3-icon-picker",
  "description": "Vue 3 icon picker",
  "version": "1.0.1",
  "private": false,
  "author": "Noé Gnanih <noegnanih@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "typings": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "dev-server": "pnpm --parallel vite",
    "dev-types": "vue-tsc  --noEmit -p tsconfig.app.json --watch",
    "build": "pnpm build-lib && pnpm build-types",
    "build-lib": "vite build",
    "build-types": "rm -f *.tsbuildinfo && vue-tsc --emitDeclarationOnly --declaration -p tsconfig.app.json",
    "lint": "eslint 'src/**/*.{ts,vue}'",
    "test": "vitest",
    "test-ci": "vitest --run",
    "version": "auto-changelog --template keepachangelog --hide-credit -p && git add CHANGELOG.md"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@arkn/icon-picker-core": "workspace:*",
    "@types/node": "26.1.2",
    "auto-changelog": "^2.6.0",
    "terser": "^5.50.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.4.0",
    "vue-virtual-scroller": "3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeGnh/icon-picker.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "icon",
    "picker",
    "iconify"
  ],
  "bugs": {
    "url": "https://github.com/noeGnh/icon-picker/issues"
  },
  "homepage": "https://github.com/noeGnh/icon-picker#readme",
  "publishConfig": {
    "access": "public"
  }
}