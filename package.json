{
  "name": "icon-picker-monorepo",
  "version": "0.1.0",
  "description": "A monorepo for the Vue 3 and React icon-picker component libraries",
  "author": "Noé Gnanih <noegnanih@gmail.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:vue": "pnpm -F playground-vue run dev",
    "dev:react": "pnpm -F playground-react run dev",
    "docs:vue": "pnpm -F docs-vue run dev",
    "docs:react": "pnpm -F docs-react run dev",
    "test:core": "pnpm -F @arkn/icon-picker-core run test-ci",
    "test:vue": "pnpm -F vue3-icon-picker run test-ci",
    "test:react": "pnpm -F @arkn/react-icon-picker run test-ci",
    "test": "pnpm test:core && pnpm test:vue && pnpm test:react",
    "build": "pnpm build-plugin && pnpm build-playground && pnpm build-docs",
    "build-plugin:vue": "pnpm -F vue3-icon-picker run build",
    "build-plugin:react": "pnpm -F @arkn/react-icon-picker run build",
    "build-plugin": "pnpm build-plugin:vue && pnpm build-plugin:react",
    "build-playground:vue": "pnpm -F playground-vue run build",
    "build-playground:react": "pnpm -F playground-react run build",
    "build-playground": "pnpm build-playground:vue && pnpm build-playground:react",
    "deploy-playground:vue": "pnpm build-playground:vue && pnpm -F playground-vue run deploy",
    "deploy-playground:react": "pnpm build-playground:react && pnpm -F playground-react run deploy",
    "deploy-playground": "pnpm deploy-playground:vue && pnpm deploy-playground:react",
    "build-docs:vue": "pnpm -F docs-vue run build",
    "build-docs:react": "pnpm -F docs-react run build",
    "build-docs": "pnpm build-docs:vue && pnpm build-docs:react",
    "lint": "eslint --ext .js,.ts,.tsx,.vue .",
    "lint:fix": "eslint --ext .js,.ts,.tsx,.vue . --fix",
    "format": "prettier **/*.{js,ts,tsx,vue} . --write",
    "commit": "git add --all && git commit",
    "commit-push": "git add --all && git commit && git push origin --all",
    "execute-husky": "npx husky install && npx husky add .husky/pre-commit \"npx --no-install lint-staged\" && npx husky add .husky/commit-msg \"npx --no -- commitlint --config commitlint.config.cjs --edit $1\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,vue}": [
      "eslint . --fix",
      "prettier . --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/prompt-cli": "^21.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.8"
  }
}